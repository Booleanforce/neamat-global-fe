{
  "name": "neamat-global-fe",
  "version": "0.1.0",
  "private": true,
  "description": "Neamat Global group frontend monorepo — neamatglobal.com and neamatcare.com",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:global": "turbo run dev --filter=neamatglobal-web",
    "dev:care": "turbo run dev --filter=neamatcare-web",
    "build": "turbo run build",
    "build:global": "turbo run build --filter=neamatglobal-web",
    "start": "turbo run start",
    "start:global": "turbo run start --filter=neamatglobal-web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,md}\"",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22"
}
